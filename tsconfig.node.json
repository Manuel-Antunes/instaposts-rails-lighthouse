{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    /* vite/inertia-graphql also runs under `node --test`, which strips types: imports name
       their .ts files, and type-only imports say so. */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "codegen.ts",
    "vite/**/*.ts",
    "test/javascript/**/*.ts",
    // The browser modules test/javascript runs under Node: none may need the DOM.
    "app/javascript/components/comments/cache.ts",
    "app/javascript/graphql/generated/possible-types.ts",
    "app/javascript/graphql/generated/type-policies.ts",
    "app/javascript/graphql/page-pagination.ts",
    "app/javascript/lib/errors.ts",
    "app/javascript/schemas/*.ts"
  ]
}
